{
  "name": "@slivervine/citadel-sdk",
  "version": "1.0.0",
  "description": "SliverVine Protocol — @slivervine/citadel-sdk · GMX v2 / Arbitrum Citadel Pre-Execution Gateway (SilverVine Labs)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:worker",
    "build:spa": "vite build",
    "build:worker": "pnpm run build:spa && pnpm exec tsc --noEmit && WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir=dist-worker",
    "bundle:measure": "tsx scripts/measure-worker-bundle.ts",
    "test": "mkdir -p coverage && vitest run --dir . --coverage",
    "grant:hl-testnet": "tsx scripts/verify-hl-testnet.ts",
    "verify:5tx": "tsx scripts/verify-5tx.ts",
    "verify:grant": "tsx scripts/verify-5tx-runner.ts",
    "verify:negative": "tsx scripts/verify-negative-proofs.ts",
    "audit:vault": "tsx scripts/audit-vault-risk.ts",
    "radar:scan": "tsx scripts/find-vault-leads.ts",
    "radar:report": "tsx scripts/generate-lead-report.ts",
    "check:mainnet": "tsx scripts/check-mainnet-env.ts",
    "ignition:dry": "tsx scripts/run-mainnet-ignition.ts",
    "ignition:live": "tsx scripts/run-mainnet-ignition.ts --live",
    "sweep:wallet-a-dry": "tsx scripts/wallet-a-sweep-dry-run.ts",
    "sweep:wallet-a": "tsx scripts/wallet-a-sweep-dry-run.ts",
    "spot:sell-hype": "tsx scripts/spot-sell-hype.ts",
    "hedge:gmx": "tsx scripts/hedge-gmx.ts",
    "hedge:gmx:dry": "tsx scripts/hedge-gmx.ts --dry-run",
    "panic:flash": "tsx scripts/panic-flash-unwind.ts",
    "demo:data": "tsx scripts/generate-demo-data.ts",
    "demo:e2e": "tsx scripts/grant-e2e-citadel-demo.ts",
    "demo:pipeline": "tsx scripts/grant-e2e-citadel-demo.ts",
    "demo:citadel": "tsx scripts/grant-e2e-citadel-demo.ts",
    "typecheck": "tsc --noEmit",
    "test:zerodev": "tsx scripts/zerodev-live-smoke.ts",
    "test:zerodev:sepolia": "tsx scripts/zerodev-testnet-userop.ts",
    "dev": "pnpm run build:spa && node scripts/wrangler-dev-guard.mjs",
    "dev:spa": "vite",
    "test:watch": "vitest",
    "deploy": "pnpm run build:spa && wrangler deploy",
    "cf-typegen": "wrangler types",
    "audit:log": "node scripts/generate-yellow-page.js",
    "audit:grant": "tsx scripts/generate-grant-audit-matrix.ts",
    "audit:slither": "bash scripts/run-static-analysis.sh --slither",
    "audit:mythril": "bash scripts/run-static-analysis.sh --mythril",
    "audit:fast": "tsx scripts/run-security-matrix.ts --tier=fast",
    "audit:security": "tsx scripts/run-security-matrix.ts --tier=security",
    "audit:nightly": "tsx scripts/run-security-matrix.ts --tier=nightly",
    "test:grant-v09-sim": "vitest run tests/v09/grant-v09-risk.test.ts tests/v09/opsec-boundary.test.ts tests/v09/aa-pipeline-opsec.test.ts",
    "test:wasm-feasibility": "vitest run tests/services/wasm-feasibility-simulation.test.ts tests/services/wasm-feasibility-lib/soil-core-sim.test.ts",
    "build:wasm": "cargo build --manifest-path src/wasm/Cargo.toml --release --target wasm32-unknown-unknown && mkdir -p pkg && cp src/wasm/target/wasm32-unknown-unknown/release/soil_core.wasm pkg/soil_core.wasm"
  },
  "keywords": [],
  "author": "SilverVine Labs",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250719.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  },
  "volta": {
    "node": "20.20.2"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "1.8.0",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/sdk": "^5.5.10",
    "ethers": "^6.17.0",
    "lucide-react": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "2.3.3",
    "viem": "^2.55.13"
  }
}
