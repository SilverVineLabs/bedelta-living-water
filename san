#!/bin/bash
set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

DARK_SYNC_FLAG=false
TARGET_CORE_BRANCH="feature/v1.5-dark-staging"
CITADEL_SYNC_DIR="${CITADEL_SYNC_DIR:-/home/lhsum/dev/bedelta-citadel-core}"

# 自動判斷分支，防止 detached HEAD 崩潰
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" = "HEAD" ]; then
    CURRENT_BRANCH="main"
    git checkout -B main
fi

# 自動解鎖 lingering rebase
if [ -d ".git/rebase-merge" ] || [ -d ".git/rebase-apply" ]; then
    echo -e "${YELLOW}Notice: Unfinished rebase detected. Aborting...${NC}"
    git rebase --abort 2>/dev/null || rm -rf .git/rebase-merge .git/rebase-apply
fi

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -dark|--dark) DARK_SYNC_FLAG=true ;;
        -m|--message) CUSTOM_MSG="$2"; shift ;;
        *) echo -e "${YELLOW}Unknown option: $1.${NC}" ;;
    esac
    shift
done

echo -e "${BLUE}[1/4] Running Typecheck & Test suite on [${CYAN}$CURRENT_BRANCH${BLUE}]...${NC}"
pnpm run typecheck

TEST_LOG=$(mktemp)
pnpm run test 2>&1 | tee "$TEST_LOG" || { rm -f "$TEST_LOG"; exit 1; }

PASSED_TESTS=$(grep -E "Tests\s+" "$TEST_LOG" | grep -oE "[0-9]+ passed \([0-9]+\)" | head -n 1)
PASSED_FILES=$(grep -E "Test Files\s+" "$TEST_LOG" | grep -oE "[0-9]+ passed \([0-9]+\)" | head -n 1)
rm -f "$TEST_LOG"

TEST_SUMMARY="${PASSED_TESTS:-All Vitest Clean} across ${PASSED_FILES:-All Files} (100% PASS)"
echo -e "${GREEN}Tests passed: $TEST_SUMMARY${NC}"

echo -e "${BLUE}[2/4] Staging and committing current repo (${CURRENT_BRANCH})...${NC}"
git add .

TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
LOG_SUMMARY=$(git diff --staged --name-only | head -n 5 | tr '\n' ', ' | sed 's/,$//')

if [ -n "$LOG_SUMMARY" ]; then
    MSG=${CUSTOM_MSG:-"sync ${CURRENT_BRANCH} ($TIMESTAMP)"}
    COMMIT_MSG="feat(citadel): ${MSG}
- Modified: [$LOG_SUMMARY]
- Verifications: $TEST_SUMMARY"

    git commit -m "$COMMIT_MSG" --author="qum0x | SilverVine <github@silvervinelabs.com>" || true
fi

echo -e "${BLUE}[3/4] Pushing current repo to origin/${CURRENT_BRANCH}...${NC}"
git push origin "$CURRENT_BRANCH" || git push origin "$CURRENT_BRANCH" --force-with-lease
echo -e "${GREEN}Main repo push complete.${NC}"

if [ "$DARK_SYNC_FLAG" = true ] && [ -d "$CITADEL_SYNC_DIR" ]; then
    echo -e "${CYAN}[4/4] Synchronizing clean core to secondary repo ($CITADEL_SYNC_DIR)...${NC}"
    rsync -av --progress --exclude='node_modules' --exclude='.git' --exclude='.wrangler' --exclude='dist' ./ "$CITADEL_SYNC_DIR/"
    
    PREV_DIR=$(pwd)
    cd "$CITADEL_SYNC_DIR"
    git checkout "$TARGET_CORE_BRANCH" 2>/devnull || git checkout -b "$TARGET_CORE_BRANCH"
    git add .
    git commit -m "feat(citadel-sync): sync core from ${CURRENT_BRANCH} ($TIMESTAMP)" || true
    git push origin "$TARGET_CORE_BRANCH" || git push origin "$TARGET_CORE_BRANCH" --force-with-lease
    cd "$PREV_DIR"
fi

echo -e "${GREEN}[ALL DONE] Audit and git push completed successfully.${NC}"