#!/bin/bash
set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

DARK_SYNC_FLAG=false
TARGET_CORE_BRANCH="feature/v1.5-dark-staging"
CITADEL_SYNC_DIR="${CITADEL_SYNC_DIR:-/home/lhsum/dev/bedelta-citadel-core}"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# 清理殘留的 rebase 死鎖
if [ -d ".git/rebase-merge" ] || [ -d ".git/rebase-apply" ]; then
    echo -e "${YELLOW}Notice: Unfinished rebase detected. Aborting lingering rebase...${NC}"
    git rebase --abort 2>/devnull || rm -rf .git/rebase-merge .git/rebase-apply
fi

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -dark|--dark) DARK_SYNC_FLAG=true ;;
        -m|--message) CUSTOM_MSG="$2"; shift ;;
        *) echo -e "${YELLOW}Unknown option: $1. Supported options: -dark (sync to ${TARGET_CORE_BRANCH}).${NC}" ;;
    esac
    shift
done

echo -e "${BLUE}[1/5] Running Typecheck & Test suite on branch [${CYAN}$CURRENT_BRANCH${BLUE}]...${NC}"
pnpm run typecheck

TEST_LOG=$(mktemp)
pnpm run test 2>&1 | tee "$TEST_LOG" || { rm -f "$TEST_LOG"; exit 1; }

PASSED_TESTS=$(grep -E "Tests\s+" "$TEST_LOG" | grep -oE "[0-9]+ passed \([0-9]+\)" | head -n 1)
PASSED_FILES=$(grep -E "Test Files\s+" "$TEST_LOG" | grep -oE "[0-9]+ passed \([0-9]+\)" | head -n 1)

rm -f "$TEST_LOG"

if [ -n "$PASSED_TESTS" ]; then
    TEST_SUMMARY="$PASSED_TESTS across $PASSED_FILES (100% PASS)"
else
    TEST_SUMMARY="All Vitest Suites Clean (100% PASS)"
fi

echo -e "${GREEN}Tests passed: $TEST_SUMMARY${NC}"

echo -e "${BLUE}[2/5] Staging and committing current repo (${CURRENT_BRANCH})...${NC}"
git add .

TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
LOG_SUMMARY=$(git diff --staged --name-only | head -n 5 | tr '\n' ', ' | sed 's/,$//')

if [ -z "$LOG_SUMMARY" ]; then
    echo -e "${YELLOW}No local changes to commit.${NC}"
else
    MSG=${CUSTOM_MSG:-"sync ${CURRENT_BRANCH} ($TIMESTAMP)"}
    COMMIT_MSG="feat(citadel): ${MSG}
- Modified: [$LOG_SUMMARY]
- Verifications: $TEST_SUMMARY"

    git commit -m "$COMMIT_MSG" --author="qum0x | SilverVine <github@silvervinelabs.com>" || true
fi

echo -e "${BLUE}[3/5] Pushing current repo to origin/${CURRENT_BRANCH}...${NC}"
git push origin "$CURRENT_BRANCH" || git push origin "$CURRENT_BRANCH" --force-with-lease
echo -e "${GREEN}Main repo push complete.${NC}"

if [ "$DARK_SYNC_FLAG" = true ]; then
    echo -e "${CYAN}[4/5] Synchronizing clean core to secondary repo ($CITADEL_SYNC_DIR)...${NC}"
    if [ -d "$CITADEL_SYNC_DIR" ]; then
        rsync -av --progress \
          --exclude='node_modules' \
          --exclude='.git' \
          --exclude='.wrangler' \
          --exclude='dist' \
          ./ "$CITADEL_SYNC_DIR/"
        echo -e "${GREEN}rsync to $CITADEL_SYNC_DIR completed successfully.${NC}"
    else
        echo -e "${YELLOW}CITADEL_SYNC_DIR ($CITADEL_SYNC_DIR) missing — skipping secondary repo rsync.${NC}"
    fi

    echo -e "${CYAN}[5/5] Committing and pushing secondary repo to remote [${TARGET_CORE_BRANCH}]...${NC}"
    if [ -d "$CITADEL_SYNC_DIR" ]; then
        PREV_DIR=$(pwd)
        cd "$CITADEL_SYNC_DIR"

        git checkout "$TARGET_CORE_BRANCH" 2>/devnull || git checkout -b "$TARGET_CORE_BRANCH"

        git add .
        SYNC_LOG_SUMMARY=$(git diff --staged --name-only | head -n 5 | tr '\n' ', ' | sed 's/,$//')

        if [ -z "$SYNC_LOG_SUMMARY" ]; then
            echo -e "${YELLOW}Secondary repo ($TARGET_CORE_BRANCH) is already up to date.${NC}"
        else
            git commit -m "feat(citadel-sync): sync core from ${CURRENT_BRANCH} ($TIMESTAMP)
- Sync Summary: [$SYNC_LOG_SUMMARY]
- Tests: $TEST_SUMMARY" || true
            git push origin "$TARGET_CORE_BRANCH" || git push origin "$TARGET_CORE_BRANCH" --force-with-lease
            echo -e "${GREEN}Secondary repo pushed successfully to ${TARGET_CORE_BRANCH}.${NC}"
        fi

        cd "$PREV_DIR"
    fi
else
    echo -e "${YELLOW}[SKIP DARK SYNC] -dark flag not provided. Skipping rsync to ${TARGET_CORE_BRANCH}.${NC}"
fi

echo -e "${GREEN}[ALL DONE] Audit and git push completed successfully.${NC}"