"}],"stateMutability":"nonpayable","type":"function","name":"tryExecute","outputs":[{"internalType":"bool","name":"ok","type":"bool"},{"internalType":"bytes","name":"result","type":"bytes"}]}],"devdoc":{"kind":"dev","methods":{"payloadHash(address,address,bytes,uint256)":{"details":"`initiator` is bound so an observer cannot front-run someone else's attestation.      `address(this)` is bound so an attestation cannot hop between executors.      `block.chainid` is bound as defence in depth — the gate's EIP-712 domain already      separates chains, so same-address CREATE2 deployments on Robinhood Chain and Arbitrum      Sepolia remain non-replayable across each other."}},"version":1},"userdoc":{"kind":"user","methods":{"allowedCount()":{"notice":"Successful gated executions. Read by /api/grant-audit."},"deniedCount()":{"notice":"Attestations refused at this executor. Read by /api/grant-audit."},"execute(address,bytes,(bytes32,address,uint8,uint16,uint64,uint64,uint256),bytes[])":{"notice":"Hard path: reverts unless the attestation authorises exactly this call."},"payloadHash(address,address,bytes,uint256)":{"notice":"Canonical payload binding."},"restrictTargets()":{"notice":"When true, only `allowedTarget` addresses may be called."},"tryExecute(address,bytes,(bytes32,address,uint8,uint16,uint64,uint64,uint256),bytes[])":{"notice":"Soft path: never performs the call on denial, but records the denial on-chain."}},"version":1}},"settings":{"remappings":["forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":true,"runs":20000},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/GatedExecutor.sol":"GatedExecutor"},"evmVersion":"shanghai","libraries":{}},"sources":{"src/GatedExecutor.sol":{"keccak256":"0x5ba4ea492b3c6dc332d27698490f306c4507c291d50397a2c9a0d7c0ed5d322a","urls":["bzz-raw://553487e64d87573bca2c01c7e46384a351bc62d6f68d27a753aab1887bcdc2a1","dweb:/ipfs/QmdFvFVZBZVbfkaBzGb3nDM1nNCeTk4Xg4vrhecE5uekCV"],"license":"MIT"},"src/interfaces/ISliverVineGate.sol